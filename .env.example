# =============================================================
# Rakaez — Environment variables template
# Copy this file to `.env.local` and fill in real values.
# =============================================================

# ---------- Sessions / auth ----------
# A 32+ char random secret used to encrypt the admin session cookie.
# Generate one with:  npm run generate-secret
SESSION_SECRET=

# JSON array of admin users. Generate password hashes with:
#   npm run hash-password "YourPassword"
#
# IMPORTANT: bcrypt hashes contain "$" characters which dotenv interprets
# as variable references and silently strips. In `.env.local` you MUST
# escape each "$" with "\". The hash-password script prints the
# correctly-escaped line for you. On Vercel/Netlify env-var UIs the
# escaping is NOT needed — paste the raw JSON.
#
# Example (.env.local format):
# ADMIN_USERS=[{"email":"admin@rakaez.com","passwordHash":"\$2b\$12\$...","name":"Admin","role":"admin"}]
ADMIN_USERS=[]

# ---------- GitHub-backed content (production only) ----------
# Personal access token with `repo` (Contents: read & write) scope.
# Leave blank in development — the writer will fall back to local fs writes.
GITHUB_TOKEN=
# Repository in "owner/repo" format, e.g. "rakaez/rakaez-app"
GITHUB_REPO=
# Branch to commit to (default: main)
GITHUB_BRANCH=main

# ---------- Contact form notifications ----------
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# The email address that should receive contact submissions.
NOTIFY_EMAIL=info@rakaezdevelopment.com
# Optional: from address used by Resend (must be a verified domain).
NOTIFY_FROM=Rakaez Website <noreply@rakaezdevelopment.com>

# ---------- SEO / public ----------
# Public URL of the deployed site (used in sitemap.xml).
SITE_URL=https://rakaez.com

# ---------- Maintenance mode ----------
# When set to "true", every public request is rewritten to /maintenance.
# The admin panel (/admin/*) stays reachable so you can keep editing content.
# Set to "false" (or remove) to take the site live.
MAINTENANCE_MODE=false

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_GA_ID=
